ASSEMBLY_API_KEY=
OPENAI_API_KEY=
OPENAI_MODELS=
FFMPEG_PATH=

# Google sign-in (see README for setup steps)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: only needed if auto-detection picks the wrong scheme/host behind a proxy
GOOGLE_REDIRECT_URI=
# Any long random string — signs the login session cookie
SESSION_SECRET_KEY=

# Panopto pilot integration (see app/services/panopto_service.py and README).
# Sandbox root only — no trailing slash, no /Panopto suffix.
PANOPTO_BASE_URL=https://mta-sandbox.cloud.panopto.eu
# From a "Server-side Web Application" API Client (System > API Clients).
PANOPTO_CLIENT_ID=
PANOPTO_CLIENT_SECRET=
# Get this by visiting /panopto/oauth/login once, approving the consent
# screen, and copying it from the callback page. Only needed for pushing
# captions (edits require acting as a real user); reads work without it.
PANOPTO_REFRESH_TOKEN=
# Must match an Allowed Redirect URL on the API Client exactly.
PANOPTO_REDIRECT_URI=http://127.0.0.1:8000/panopto/oauth/callback
# Folder GUID to poll for new recordings (from the folder's URL in Panopto)
PANOPTO_FOLDER_ID=
PANOPTO_CAPTION_LANGUAGE=Hebrew
# Lets a scheduled caller (the GitHub Action in .github/workflows/panopto-sync.yml)
# trigger /panopto/sync without a logged-in session. Generate with, e.g.,
# `python3 -c "import secrets; print(secrets.token_urlsafe(32))"` — must match
# the PANOPTO_SYNC_SECRET repo secret in GitHub exactly. Leave unset to
# disable the automated path (POST /panopto/sync still works for a logged-in
# human either way).
PANOPTO_SYNC_SECRET=
# Optional: which user id owns Lecture rows created by an automated sync, and
# the only account allowed to use the pilot controls from a browser session.
# Defaults to the lowest-id user (fine with one real account).
PANOPTO_SYNC_OWNER_USER_ID=

# --- Reliability tuning (all optional; defaults shown are the built-in ones) ---
# Recordings claimed per /panopto/sync call. One per invocation keeps each run
# bounded; a backlog drains at this rate every poll.
PANOPTO_MAX_NEW_PER_SYNC=1
# Give up on a recording after this many failed ingest attempts, and on its
# captions after this many failed pushes. Without a ceiling a permanently
# broken recording is re-downloaded every couple of minutes forever.
PANOPTO_MAX_INGEST_ATTEMPTS=4
PANOPTO_MAX_CAPTION_ATTEMPTS=4
# A lecture still marked "processing" whose heartbeat has been quiet this long
# is treated as a dead worker and made retryable.
PANOPTO_STALL_MINUTES=30
# Ceiling on waiting for AssemblyAI on a single recording.
TRANSCRIPTION_TIMEOUT_MINUTES=40
